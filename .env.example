# Copia este archivo como apps/web/.env.local y completa los valores.

# Supabase (Project Settings → API). La publishable key es pública: puede ir al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# URL pública del sitio (metadatos y enlaces para compartir).
# En Vercel no hace falta: se usa VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
