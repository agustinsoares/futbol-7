# Copia este archivo como apps/web/.env.local y completa los valores.

# Supabase (Project Settings → API). La publishable key es pública: puede ir al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# URL pública del sitio (metadatos y enlaces para compartir).
# En Vercel no hace falta: se usa VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Muestra el botón "Continue with Google" (requiere activar el proveedor Google en Supabase).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="false"

# Tarea diaria (recordatorios por email y cierre de partidos). Solo servidor.
CRON_SECRET="una-cadena-larga-y-aleatoria"
SUPABASE_SECRET_KEY="sb_secret_..."
RESEND_API_KEY=""
EMAIL_FROM="Aalto Football <hola@tu-dominio>"

# Tráfico de Vercel Web Analytics en el panel /admin (opcional). Solo servidor.
# Token: vercel.com/account/tokens (alcance: el equipo del proyecto). IDs: Project Settings → General.
VERCEL_ANALYTICS_TOKEN=""
VERCEL_ANALYTICS_PROJECT_ID="prj_..."
VERCEL_ANALYTICS_TEAM_ID="team_..."
